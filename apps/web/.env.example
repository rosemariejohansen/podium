AUTH_SECRET=__AUTH_SECRET__
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret
AUTH_TRUST_HOST=true
# 1 enables the test sign-in provider for local and CI end-to-end runs only.
# The app refuses to start with 1 on any Vercel deployment (PRD SEC-WEB-9).
AUTH_TEST_MODE=0
API_URL=http://localhost:4000
SERVICE_TOKEN_PRIVATE_KEY=__SERVICE_TOKEN_PRIVATE_KEY__
