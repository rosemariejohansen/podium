{
  "name": "podium",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:setup": "node scripts/dev-setup.mjs",
    "db:up": "docker compose -f infra/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/compose.dev.yml down",
    "db:migrate": "pnpm --filter @mos/api db:migrate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
