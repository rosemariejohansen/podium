{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "agentGuidance": false,
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build", "db:generate"] },
    "test": { "dependsOn": ["^build", "db:generate"], "outputs": [] },
    "test:e2e": { "dependsOn": ["^build", "db:generate"], "cache": false },
    "dev": { "dependsOn": ["^build", "db:generate"], "cache": false, "persistent": true }
  }
}
